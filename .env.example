# ---------------------------------------------------------------------------
# Kaycee sample onboarding app — configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust.
#
# CREDENTIALS ARE YOURS TO BRING. There is no auto-provisioning: request
# sandbox access at https://knowyourcustomer.com/developers/access/ (approval-
# gated; the client ID + secret arrive by email). Then EITHER paste them into
# the app's connect screen (per-visitor, sealed into an HttpOnly cookie) OR set
# SANDBOX_CLIENT_ID/SECRET below for a private deployment that is always
# connected as your tenant.
#
# Going to PRODUCTION is a config change, not a code change:
#   1. point SANDBOX_BASE_URL at the live KYC Public API
#   2. set SANDBOX_CLIENT_ID + SANDBOX_CLIENT_SECRET to your real credentials
# Nothing in the app code changes.

# Base URL of the KYC API. Defaults to the public sandbox.
SANDBOX_BASE_URL=https://api.knowyourcustomer.dev

# OPTIONAL token-endpoint override. When unset, the token URL is derived as
# ${SANDBOX_BASE_URL}/connect/token (unchanged default behaviour). Set this when
# the OAuth token host differs from the API host — e.g. a second instance
# pointed at the live env where auth lives on a separate host.
# SANDBOX_TOKEN_URL=https://auth.example.com/connect/token

# OPTIONAL long-lived credentials — YOUR OWN, from the developer-portal access
# request. Set BOTH to run in STATIC mode: every visitor shares this tenant and
# the connect gate is skipped (e.g. a private/self-hosted deployment, or the
# live-env instance). Leave BOTH blank and each visitor must connect their own
# credentials on the app's connect screen before the journey unlocks.
SANDBOX_CLIENT_ID=
SANDBOX_CLIENT_SECRET=

# OAuth scope. Sandbox and live both use "PublicApi"; rarely need to change.
SANDBOX_SCOPE=PublicApi

# SESSION_SECRET — server key for the "bring your own credentials" session.
# Pasted credentials are AES-256-GCM-encrypted ("sealed") into an HttpOnly
# cookie using a key derived from this secret, so any replica can recover the
# session without a shared store. Any long random string works (32+ chars
# recommended). REQUIRED in any real deployment: without it a loud dev-only
# fallback key is used, BYO sessions are forgeable, and sessions break whenever
# the fallback changes. Rotating it just logs testers out (they re-connect).
# The webhook callback token (see APP_PUBLIC_URL) is derived from it too.
# SESSION_SECRET=change-me-32-plus-random-chars

# APP_PUBLIC_URL — OPTIONAL. This app's OWN public origin, reachable by the
# sandbox (e.g. https://kaycee.knowyourcustomer.dev). When set, the app
# registers a webhook subscription and consumes case events the webhook way —
# the recommended integration, matching how the real KYC product notifies you.
# When unset (e.g. a local clone the sandbox cannot reach), the journey falls
# back to polling case status — the documented alternative.
# APP_PUBLIC_URL=https://kaycee.example.com

# ---------------------------------------------------------------------------
# Example: a STATIC-creds instance pointed at the live env (do NOT deploy this
# casually — it creates real cases). Mode is "static" automatically when both
# creds are set.
#   SANDBOX_BASE_URL=https://<live-api-host>
#   SANDBOX_TOKEN_URL=https://<live-auth-host>/connect/token
#   SANDBOX_CLIENT_ID=<live-client-id>
#   SANDBOX_CLIENT_SECRET=<live-client-secret>
# ---------------------------------------------------------------------------
