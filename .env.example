# ---------------------------------------------------------------------------
# Kaycee sample onboarding app: configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. The defaults work with ZERO edits: the app
# runs against the free public sandbox and auto-provisions a throwaway tenant on
# first run, so you can try the journey with no credentials.
#
# To run against YOUR OWN sandbox tenant (so you see the same cases you see when
# you call the API directly), you do NOT need env vars: just paste your sandbox
# client_id and client_secret into the "Connect your sandbox" screen in the app.
# Request free credentials at https://knowyourcustomer.com/developers.

# Base URL of the KYC API. Defaults to the free public sandbox.
SANDBOX_BASE_URL=https://api.knowyourcustomer.dev

# OPTIONAL token-endpoint override. When unset, the token URL is derived as
# ${SANDBOX_BASE_URL}/connect/token (the default). Set this only when the OAuth
# token host differs from the API host.
# SANDBOX_TOKEN_URL=https://auth.example.com/connect/token

# OPTIONAL long-lived credentials. Leave BOTH blank to run in the auto-provision
# demo mode. Set BOTH to pin the app to one fixed sandbox tenant (no
# provisioning). For per-session credentials, prefer the in-app connect screen.
SANDBOX_CLIENT_ID=
SANDBOX_CLIENT_SECRET=

# OAuth scope. The sandbox uses "PublicApi"; you rarely need to change this.
SANDBOX_SCOPE=PublicApi

# Server key used to encrypt the "connect your sandbox" session cookie
# (AES-256-GCM). Set any long random string (32+ chars) in a real deployment,
# or per-session connect cookies will not survive a restart / multiple replicas.
# In local dev it falls back to an insecure built-in key with a warning.
# SESSION_SECRET=change-me-to-a-long-random-string
